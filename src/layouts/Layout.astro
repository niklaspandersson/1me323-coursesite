---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Webbplats för en introduktionskurs i webbutveckling"
    />
    <meta name="Keywords" content="webbteknik, data, javascript, html, css" />
    <meta
      name="Description"
      content="Webbplats för en introduktionskurs i datadrivna, dynamiska webbplatser med Javascript"
    />
    <meta name="Author" content="Niklas Andersson" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href={import.meta.env.BASE_URL + "icon_v3.png"}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --siteMaxWidth: 1200px;
    --primaryTextColor: black;
    --primaryBgColor: #f4fcf5;
    --secondaryBgColor: #333;
    --mainTextColor: black;
    --secondaryTextColor: white;
    --lightAccentColor: #e6efe8;
    --lnuAccentColor: #89cc66;
    --lnuAccentColorTransparent: rgba(137, 204, 102, 0.3);
  }

  /** reset */
  html {
    /* Storlek på 1rem */
    font-size: 16px;

    overflow-y: scroll;
    scroll-behavior: smooth;
    background-color: #fff;
  }

  body {
    /* Ser till att sidfoten trycks ner på sidor med lite innehåll */
    min-height: 100vh;
    display: flex;
    flex-flow: column nowrap;
  }

  html,
  body,
  nav,
  header,
  main,
  aside,
  footer,
  article,
  section,
  div,
  iframe {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  li {
    margin-bottom: 0.5rem;
  }

  nav li {
    margin-bottom: 0;
  }

  details {
    margin-top: 0.3rem;
  }

  a,
  a:visited,
  a:active,
  a:hover {
    color: var(--primaryTextColor);
  }

  ul {
    margin-left: 1.4em;
    padding-left: 0;
  }

  details {
    summary {
      cursor: pointer;
    }
  }

  /** typography */
  body {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    margin: 0;
    padding: 0.2rem 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  h4,
  h5 {
    font-style: normal;
    font-size: 1em;
  }

  h3 + p,
  h4 + p,
  h5 + p,
  h4 + ul,
  h5 + ul,
  h4 + ol,
  h5 + ol {
    /* p- eller ul-element som ligger direkt efter h4 eller h5 */
    margin-top: 0.2rem;
  }

  p,
  ul,
  ol {
    line-height: 1.4;
  }

  em {
    /* color: rgb(88, 82, 67); */
    font-size: 0.95em;
    font-style: italic;
    /* font-weight: bold; */
  }

  main h3 {
    background: linear-gradient(
      to right,
      var(--lightAccentColor) 0%,
      var(--primaryBgColor) 100%
    );
    padding-left: 5px;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  aside h3,
  header h3 {
    background: unset;
  }

  /** imported */
  .imported {
    li > p {
      margin-bottom: 0rem;
    }

    ul,
    ol {
      margin-bottom: 1rem;

      ul,
      ol {
        margin-bottom: 0.3rem;
      }
    }

    aside {
      ul,
      ol {
        margin-bottom: 0;
      }
    }

    .questions > ol {
      counter-reset: item;
      list-style-type: none;
      padding-left: 0;

      > li {
        > p {
          font-weight: bold;
          display: inline-block;
        }

        &:before {
          font-weight: bold;
          content: "F" counter(item, decimal) ". ";
          counter-increment: item;
        }
      }
    }

    code {
      word-break: break-all;
    }

    .note {
      position: relative;
      padding: 20px;
      margin: 0 20px;
      padding-left: 60px;
      background-color: var(--lightAccentColor);
      border: 2px dotted var(--secondaryBgColor);
      margin-bottom: 1rem;

      p {
        margin-bottom: 0;
      }

      &:before {
        content: " ";
        display: block;
        position: absolute;
        left: 5px;
        top: 0;
        width: 48px;
        height: 100%;
        opacity: 0.2;
        background: url(/wt3/img/info_icon.png) no-repeat;
        background-position: 0 center;
        background-size: contain;
      }
    }

    .novideo {
      cursor: not-allowed;
    }
  }

  /** details */
  .labs,
  .assignments {
    details {
      padding: 5px;
      margin-bottom: 1em;
      border: 2px solid transparent;

      summary {
        width: max-content;
        padding: 6px;
        background-color: var(--secondaryBgColor);
        color: var(--secondaryTextColor);
      }

      &[open] {
        background-color: var(--lightAccentColor);
        border: 2px dotted var(--secondaryBgColor);

        code,
        pre {
          background-color: rgb(240, 243, 247);
        }

        summary {
          margin-bottom: 1em;
        }
      }
    }
  }

  div.hidden {
    background-color: black;
    transition: background-color 0.15s ease;
    padding: 4px;
  }
  div.hidden::before {
    content: "Svar: ";
    color: white;
    text-align: center;
    padding: 0.5rem;
  }
  div.hidden:hover {
    background-color: rgba(0, 0, 0, 0.1);

    &::before {
      color: black;
    }
  }

  .imported {
    display: contents;

    code {
      background-color: rgb(240, 243, 247);
      padding: 0 3px;
      font-size: 0.9rem;
    }
    pre code {
      background-color: unset;
    }
  }

  .centered {
    text-align: center;
  }

  aside.first {
    order: -1;
  }
</style>
